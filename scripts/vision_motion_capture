#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python="${POSE_CAPTURE_PYTHON:-${HOME}/anaconda3/envs/pose-capture/bin/python}"

cd "${repo_root}"

exec env \
  -u PYTHONPATH \
  -u LD_LIBRARY_PATH \
  -u QT_QPA_PLATFORM_PLUGIN_PATH \
  -u QT_PLUGIN_PATH \
  PYTHONNOUSERSITE=1 \
  PYTHONPATH="${repo_root}/pose-capture" \
  "${python}" \
  "${repo_root}/pose-capture/realsense_motion_capture/live_capture.py" \
  --output-dir "${repo_root}/recordings/rtmo-d435" \
  --serial 313522072015 \
  --pose2d rtmo-l_16xb16-600e_coco-640x640 \
  --device cuda:0 \
  --record-immediately \
  "$@"
