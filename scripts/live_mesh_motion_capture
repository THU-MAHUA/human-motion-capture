#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python="${POSE_CAPTURE_PYTHON:-}"
mesh_python="${MESH_CAPTURE_PYTHON:-${HOME}/anaconda3/envs/mesh-capture/bin/python}"

if [[ -z "${python}" && -n "${CONDA_PREFIX:-}" ]]; then
  python="${CONDA_PREFIX}/bin/python"
fi
if [[ -z "${python}" ]]; then
  python="$(command -v python3 || true)"
fi
if [[ -z "${python}" || ! -x "${python}" ]]; then
  echo "Activate pose-capture or set POSE_CAPTURE_PYTHON." >&2
  exit 1
fi
if [[ ! -x "${mesh_python}" ]]; then
  echo "Set MESH_CAPTURE_PYTHON to the mesh environment's Python executable." >&2
  exit 1
fi

cd "${repo_root}"

exec env \
  -u PYTHONPATH \
  -u LD_LIBRARY_PATH \
  -u QT_QPA_PLATFORM_PLUGIN_PATH \
  -u QT_PLUGIN_PATH \
  PYTHONNOUSERSITE=1 \
  "${python}" \
  -m realsense_motion_capture.live_capture \
  --output-dir "${repo_root}/recordings/live-mesh-d435" \
  --serial 313522072015 \
  --pose2d rtmo-l_16xb16-600e_coco-640x640 \
  --device cuda:0 \
  --hmr2 \
  --hmr2-python "${mesh_python}" \
  --hmr2-device cuda:0 \
  --mesh-preview \
  --record-immediately \
  "$@"
